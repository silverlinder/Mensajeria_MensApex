{
  "info": {
    "name": "Keycloak + Liberty JWT Auth Test",
    "_postman_id": "f84d1cb8-01a4-4e9e-8f1e-a4375b441111",
    "description": "Colección para probar autenticación con Keycloak y MicroProfile JWT en Open Liberty",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Obtener token (Direct Access Grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "liberty-app"
            },
            {
              "key": "client_secret",
              "value": "my-liberty-secret"
            },
            {
              "key": "username",
              "value": "testuser"
            },
            {
              "key": "password",
              "value": "testpass"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8081/realms/dev/protocol/openid-connect/token",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "realms",
            "dev",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Llamar endpoint protegido",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:9080/miapp/secure/authenticated",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "9080",
          "path": [
            "miapp",
            "secure",
            "authenticated"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Ver configuración OIDC (.well-known)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8081/realms/dev/.well-known/openid-configuration",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "realms",
            "dev",
            ".well-known",
            "openid-configuration"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": ""
    }
  ]
}
